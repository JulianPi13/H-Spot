# =============================================================
# H-SPOT — Variables de entorno
# En tu computador: copia este archivo como ".env" (en la misma carpeta).
# En Vercel: escribe estas variables en Settings > Environment Variables.
# NUNCA subas el archivo .env a GitHub.
# =============================================================

# Entorno: development | production
NODE_ENV=development
PORT=3000

# Dirección pública de la tienda (sin "/" al final). En producción: https://tudominio.com
APP_URL=http://localhost:3000

# Conexión a MySQL: mysql://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/BASE_DE_DATOS
DATABASE_URL="mysql://hspot:CAMBIA_ESTA_CONTRASENA@localhost:3306/hspot"

# Base de datos SOLO para las pruebas automáticas (npm test). Se borra en cada prueba.
# Si la dejas comentada se usa la misma de arriba con "_test" al final (hspot_test).
# TEST_DATABASE_URL="mysql://hspot:CAMBIA_ESTA_CONTRASENA@localhost:3306/hspot_test"

# Clave secreta para firmar las sesiones. Genera una con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_ALEATORIA

# Orígenes permitidos para CORS (separados por coma). Normalmente el mismo APP_URL.
CORS_ORIGINS=http://localhost:3000

# Horas que se reserva el inventario de un pedido sin confirmar
ORDER_RESERVATION_HOURS=48

# Tamaño máximo por foto en MB (en Vercel el máximo posible es 4)
MAX_UPLOAD_MB=4

# ---------- Solo para Vercel ----------
# Clave para crear el PRIMER administrador desde /configuracion-inicial (mín. 24 caracteres).
# Bórrala después de crear el administrador.
SETUP_TOKEN=
# Clave que Vercel usa para ejecutar la tarea diaria que libera reservas vencidas.
CRON_SECRET=
# "false" para no crear productos de demostración al publicar.
SEED_DEMO=true
# Vercel Blob (fotos): Vercel la agrega sola al conectar un "Blob store".
# BLOB_READ_WRITE_TOKEN=

# ---------- Correo (opcional) ----------
# Si lo dejas vacío, la recuperación de contraseña y la verificación de correo
# NO enviarán correos (el sistema lo indicará claramente).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="H-SPOT <no-reply@tudominio.com>"

# Solo para desarrollo local SIN correo: imprime en la consola del servidor el
# enlace de restablecimiento. Nunca activar en producción.
DEV_PRINT_EMAIL_LINKS=false
